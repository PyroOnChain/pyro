# Pyro factory, once deployed. Every app route shows a "not deployed" screen until this is set.
NEXT_PUBLIC_CLUB_FACTORY=

# Optional. Defaults to the public Robinhood Chain RPC, which is rate limited and
# explicitly not for production. Use Alchemy or another provider before launch.
NEXT_PUBLIC_RPC_URL=

# Local dev only: override the stock list so the app points at a locally deployed token.
# Leave unset in production, where the verified mainnet addresses are used.
NEXT_PUBLIC_STOCKS=
